# ── 本地工具链与构建缓存 ──
_toolchain/
target/
node_modules/
*.log
_env_check*.txt
_msvc*.txt

# ── 构建 / 发布产物 ──
# 安装包太大且每次发版都变，只放 GitHub Releases；绿色版 exe 入库，
# 这样 clone 下来不用装 Rust 工具链也能直接双击使用
dist/*
dist/_old/
*.exe
*.msi
*.pdb
!dist/mdconv.bat
!dist/MDeditor.exe

# ── 本地工作数据 / 编辑器状态 ──
# 「最近打开」列表、窗口状态、主题等运行时数据只存在 WebView2 的
# localStorage（本机用户目录），不写进仓库；下列模式是防止误提交的兜底。
.workbuddy/
.vscode/
.idea/
settings.json
recent*.json
*.mde-state
*.mde-session
EBWebView/

# ── 备份、回归产物与调试输出（本地，不上传）──
_backup/
_verify/
/1
_*.txt
*.tmp
*.bak
*.old
*.prev
